{
  "name": "cityofgod",
  "private": true,
  "scripts": {
    "build": "esbuild js/vehicle-webgl.mjs --bundle --minify --format=esm --outfile=js/vehicle-webgl.bundle.js",
    "build:site": "npm run build && node tools/build-site.mjs",
    "start": "node tools/serve.mjs",
    "test:characters": "node --test tests/character-actions.test.mjs",
    "test:pets": "node --test tests/pets.test.mjs",
    "test:front": "node --test tests/front-end.test.cjs",
    "judge:home": "node tools/judge-city-home.cjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "sharp": "^0.35.5",
    "three": "0.186.1"
  }
}
